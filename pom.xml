<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
	</parent>

	<groupId>com.zxf</groupId>
	<artifactId>zxf-hazelcast-spring-session</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>zxf-hazelcast-spring-session</name>

	<properties>
		<java.version>21</java.version>
		<!-- Spring Boot 4.1 BOM 默认管理 hazelcast 5.5.0, 这里提升到 5.7.0 以匹配 hazelcast-spring-session 4.0.0 的运行时要求 -->
		<hazelcast.version>5.7.0</hazelcast.version>
		<!-- Spring Session 4.0 起, Hazelcast 集成改由 Hazelcast 团队维护, 制品坐标变更为 com.hazelcast.spring:hazelcast-spring-session -->
		<hazelcast-spring-session.version>4.0.0</hazelcast-spring-session.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>
		<!-- Spring Boot 4.x 将 Hazelcast 自动配置外置为独立 starter (spring-boot-hazelcast), 不再随 spring-boot-autoconfigure 自动生效 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-hazelcast</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.session</groupId>
			<artifactId>spring-session-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.hazelcast.spring</groupId>
			<artifactId>hazelcast-spring-session</artifactId>
			<version>${hazelcast-spring-session.version}</version>
		</dependency>
		<dependency>
			<groupId>com.hazelcast</groupId>
			<artifactId>hazelcast</artifactId>
		</dependency>
		<dependency>
			<groupId>org.openjdk.jol</groupId>
			<artifactId>jol-core</artifactId>
			<version>0.17</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-properties-migrator</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
